# ============================================================
# SillyTavern Online — 环境变量示例
#
# 用法：
#   1. 复制本文件内容到你的部署平台的环境变量 / Secrets
#      （Hugging Face Spaces → Settings → Variables and secrets）
#   2. 或本地 docker 运行时通过 -e 参数传入
# ============================================================

# ---------------- 必需 ----------------

# 你的备份 Git 仓库（HTTPS 格式，无需包含 Token，脚本会自动注入）
# 支持：github.com/用户名/仓库名.git （可带 https:// 前缀；
#       也可直接填已含凭据的完整 URL）
BACKUP_REPO_URL=github.com/your-username/sillytavern-profiles.git

# GitHub Personal Access Token（需要 repo 写权限）
# 创建方法：GitHub → Settings → Developer settings → Personal access tokens
BACKUP_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# SillyTavern 登录用户名 / 密码（用于基础认证）
USERNAME=admin
TAVERN_PASSWORD=change-me-please

# ---------------- 可选（有默认值） ----------------

# 是否启用 GitHub 备份（恢复 + 自动备份），false 时使用全新数据
#ENABLE_BACKUP=true

# 备份仓库分支
#BACKUP_BRANCH=main

# 自动备份 cron 表达式（默认每 5 分钟一次）
#BACKUP_SCHEDULE=*/5 * * * *

# git 提交身份（出现在备份仓库的提交记录里）
#GIT_USER_NAME=SillyTavern Backup
#GIT_USER_EMAIL=backup@sillytavern.local

# SillyTavern 监听端口（Hugging Face Spaces 固定使用 7860）
#PORT=7860